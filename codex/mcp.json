{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "ultiwrite-forensics": {
      "type": "streamable-http",
      "url": "https://mcp.ultiwrite.co/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "forensics:read",
              "forensics:analyze",
              "forensics:delete"
            ]
          }
        }
      }
    }
  }
}
